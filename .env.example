# AWS Configuration
AWS_ACCESS_KEY_ID="Your AWS Access Key"
AWS_SECRET_ACCESS_KEY="Your AWS Secret Key"
AWS_REGION=us-east-1
S3_BUCKET="Your S3 Bucket name"

# Bedrock Model Configuration
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

# Pinecode Vector DB Configuration
PINECONE_API_KEY="Your Pinecode API Key"
PINECONE_INDEX_HOST=enterprise-ai-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

# Postgres DB Configuration
DATABASE_URL="Your Postgres DataBase URl"

# RIUS Observability Configuration
RIUS_API_KEY="Your RIUS API KEY"
RIUS_SERVICE_NAME=Enterprise-AI
RIUS_DISABLED=flase
RIUS_CAPTURE_CONTENT=false